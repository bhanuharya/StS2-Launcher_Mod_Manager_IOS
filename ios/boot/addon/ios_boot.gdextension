[configuration]

entry_symbol = "ios_boot_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

ios.debug = "res://addons/ios_boot/libios_boot.ios.dylib"
ios.release = "res://addons/ios_boot/libios_boot.ios.dylib"
linux.debug.x86_64 = "res://addons/ios_boot/libios_boot.linux.x86_64.so"
linux.release.x86_64 = "res://addons/ios_boot/libios_boot.linux.x86_64.so"
